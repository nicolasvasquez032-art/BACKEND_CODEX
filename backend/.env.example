ENVIRONMENT=development
CORS_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://talentmatch:talentmatch@localhost:5432/talentmatch
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ML_SERVICE_URL=http://localhost:8001

# SMTP (para recuperación de contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@talentmatch.app

# Frontend (para back_urls de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# Mercado Pago — NUNCA poner el token real en el código fuente
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
MP_BACK_URL_BASE=https://tu-dominio.com
